# Browser-visible Neon configuration
VITE_NEON_DATA_API_URL=https://<neon-endpoint>/neondb/rest/v1
VITE_NEON_AUTH_URL=https://<neon-auth-endpoint>/neondb/auth
VITE_R2_PUBLIC_URL=https://<your-r2-public-domain>
VITE_REALTIME_POLL_MS=5000

# Netlify server-side variables; never expose these as VITE_ variables
DATABASE_URL=postgresql://<server-only-neon-connection-string>
NEON_AUTH_JWKS_URL=https://<neon-auth-endpoint>/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LOVABLE_API_KEY=
FLUTTERWAVE_SECRET_KEY=
R2_BUCKET=
FRONTEND_ORIGIN=https://<your-netlify-site>
